# ---- Supabase (Project Settings → API) ----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Service role key — server-side only, never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Google / Gmail (Phase 2) ----
# Google Cloud console → APIs & Services → Credentials → OAuth 2.0 Client ID
# (Web application). Authorised redirect URI must be exactly:
#   http://localhost:3000/api/google/callback           (local dev)
#   https://support.blankssportsnutrition.com/api/google/callback  (production)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Encrypts OAuth refresh tokens at rest (AES-256-GCM) and signs the OAuth
# state parameter. Generate with:  openssl rand -base64 32
# Changing this invalidates every stored token — agents must reconnect.
TOKEN_ENCRYPTION_KEY=

# Optional. Pins the OAuth redirect URI instead of deriving it from the
# request origin. Set this in production; leave unset for localhost.
# NEXT_PUBLIC_SITE_URL=https://support.blankssportsnutrition.com

# Reply-To on outbound mail. Agents send from their own address, so without
# this a customer's reply lands in that agent's personal mailbox instead of
# the shared inbox the ticket system watches. Falls back to the connected
# support mailbox address when unset.
SUPPORT_EMAIL=support@blankssportsnutrition.com

# ---- Inbound email (Phase 2c) ----
# Shared secret for the Pub/Sub push endpoint. REQUIRED in production —
# without it /api/webhooks/gmail accepts any caller. Generate with:
#   openssl rand -hex 32
GMAIL_WEBHOOK_TOKEN=

# Google Cloud Pub/Sub topic Gmail pushes change notifications to, e.g.
# projects/blanks-support/topics/gmail-inbound. Production only.
GMAIL_PUBSUB_TOPIC=

# Local development only: how often the dashboard polls the support mailbox,
# in seconds, standing in for Pub/Sub push. Leave unset in production.
NEXT_PUBLIC_MAIL_POLL_SECONDS=60
