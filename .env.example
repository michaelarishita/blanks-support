# ---- Supabase (Project Settings → API) ----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Service role key — server-side only, never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Google / Gmail (Phase 2) ----
# Google Cloud console → APIs & Services → Credentials → OAuth 2.0 Client ID
# (Web application). Authorised redirect URI must be exactly:
#   http://localhost:3000/api/google/callback           (local dev)
#   https://support.blankssportsnutrition.com/api/google/callback  (production)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Encrypts OAuth refresh tokens at rest (AES-256-GCM) and signs the OAuth
# state parameter. Generate with:  openssl rand -base64 32
# Changing this invalidates every stored token — agents must reconnect.
TOKEN_ENCRYPTION_KEY=

# Optional. Pins the OAuth redirect URI instead of deriving it from the
# request origin. Set this in production; leave unset for localhost.
# NEXT_PUBLIC_SITE_URL=https://support.blankssportsnutrition.com

# Reply-To on outbound mail, and the mailbox this app connects and watches.
# Agents send from their own address, so without this a customer's reply lands
# in that agent's personal mailbox instead of the shared inbox. Falls back to
# the connected mailbox's address when unset.
#
# NOTE: this is hello@, not support@. support@ still routes to Melissa's
# existing setup during the parallel run and must not be touched.
SUPPORT_EMAIL=hello@blankssportsnutrition.com
# Senders whose mail is dropped instead of becoming a ticket, on top of the
# automatic guards (our own agents, SUPPORT_EMAIL, the connected mailbox).
# Comma-separated, matched case-insensitively on the From address.
# Seeded with support@ for the Gorgias parallel run: it still routes to the
# old help desk, and a reply sent from there can land in the watched mailbox,
# where it would otherwise open a ticket answering ourselves.
IGNORED_SENDER_EMAILS=support@blankssportsnutrition.com
# Addresses we receive forwarded mail through. Comma-separated.
# support@ is a Google Group with hello@ as a member during the Gorgias
# parallel run. Groups stamps List-Id, List-Unsubscribe, Mailing-list and
# Precedence: list on everything it forwards — the same headers a newsletter
# carries — so without this, real customer mail arriving via the group is
# discarded as bulk. A trusted forwarder suppresses ONLY the bulk-mail rule;
# auto-reply and internal-sender guards still apply.
TRUSTED_FORWARD_ADDRESSES=support@blankssportsnutrition.com



# ---- Inbound email (Phase 2c) ----
# Shared secret for the Pub/Sub push endpoint. REQUIRED in production —
# without it /api/webhooks/gmail accepts any caller. Generate with:
#   openssl rand -hex 32
GMAIL_WEBHOOK_TOKEN=

# Google Cloud Pub/Sub topic Gmail pushes change notifications to, e.g.
# projects/blanks-support/topics/gmail-inbound. Production only.
GMAIL_PUBSUB_TOPIC=

# How often an open dashboard re-checks the support mailbox, in seconds.
# Defaults to 300. This is a SAFETY NET behind Pub/Sub push, not the
# mechanism — it covers a lapsed watch or a dropped notification. The server
# throttles syncs globally to one per minute regardless of this value, so
# lowering it does not multiply Gmail calls. Set 0 to disable.
NEXT_PUBLIC_MAIL_POLL_SECONDS=300

# ---- Widget CORS ----
# Comma-separated origins allowed to POST to /api/tickets/intake from a
# browser. Falls back to the blankssportsnutrition.com apex + www when unset.
# Add the Shopify storefront domain here if the site is served from one.
# NEXT_PUBLIC_SITE_URL is always allowed, and localhost:3000 in dev only.
WIDGET_ALLOWED_ORIGINS=https://blankssportsnutrition.com,https://www.blankssportsnutrition.com

# ---- Cron jobs (production) ----
# Guards /api/cron/*. Vercel sends it as `Authorization: Bearer $CRON_SECRET`
# on scheduled runs. If unset, the cron endpoints refuse to run rather than
# defaulting open. Generate with: openssl rand -hex 32
CRON_SECRET=

# Where inbound-down alerts are emailed. Sent through the support mailbox.
ALERT_EMAIL=michael@blankssportsnutrition.com
