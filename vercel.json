{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/notifications",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/inbound-heartbeat",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/retry-sends",
      "schedule": "20 * * * *"
    },
    {
      "path": "/api/cron/renew-watch",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/auto-close",
      "schedule": "30 4 * * *"
    }
  ]
}
